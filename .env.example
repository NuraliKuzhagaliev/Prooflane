# Copy to .env. Do not paste secrets into chat or commit this file.
# Local reference and Docker-recipe modes require no API key.
VULTR_INFERENCE_API_KEY=
# Choose a chat model that supports response_format=json_object.
# Example from the November 2026 catalog: deepseek-v4.1-flash-1017
VULTR_MODEL=
# Separate operator password: required to enable paid/credit-backed model calls.
PROOFLANE_OPERATOR_TOKEN=
# Live requests disabled by default, even when a key exists.
PROOFLANE_LIVE_ENABLED=false
PROOFLANE_PUBLIC_ORIGIN=http://127.0.0.1:8765
PROOFLANE_SANDBOX_IMAGE=prooflane-sandbox:local
PROOFLANE_DATA_DIR=data
